// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  birthDate   DateTime
  gender      String?
  phone       String?
  password    String
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  preferences DecorPreference?
  suggestions DecorSuggestion[]
  tokens      UserToken[]
}

model UserToken {
  id           String   @id @default(uuid())
  userId       String
  refreshTokenHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10,2)
  category    Category
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model DecorPreference {
  id              String   @id @default(uuid())
  userId          String   @unique 
  ambiente        Ambiente
  estilo          Estilo
  coresPreferidas String[] // Postgres suporta array
  orcamento       Orcamento
  descricaoLivre  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DecorSuggestion {
  id              String   @id @default(uuid())
  userId          String @index
  prompt          String
  response        Json
  ambiente        Ambiente?
  estilo          Estilo?
  cores           String[]
  orcamento       Orcamento?
  modelUsed String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FavoriteSuggestion {
  id           String   @id @default(uuid())
  userId       String
  suggestionId String
  createdAt    DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion  DecorSuggestion  @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([userId, suggestionId])
}

enum Role {
  ADMIN
  USER
}

enum Ambiente {
  SALA
  QUARTO
  COZINHA
  BANHEIRO
  ESCRITORIO
}

enum Estilo {
  MODERNO
  MINIMALISTA
  CLASSICO
  INDUSTRIAL
  RUSTICO
}

enum Orcamento {
  BAIXO
  MEDIO
  ALTO
}
enum Category {
  CADEIRA
  MESA
  SOFA
  DECORACAO
}